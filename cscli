#!/usr/bin/env python3
"""cscli launcher - dispatch between the interactive console and the
non-interactive (AI/script) driver.

No arguments      -> interactive Console (human operator)
With a subcommand  -> non-interactive runner, e.g.:
    cscli --server --https --port 443 --key mypass
    cscli --payload --url https://HOST:443 --out beacon.py --key mypass
    cscli --list
    cscli --task <sid> "shell id" --wait
    cscli --results <sid>
"""
import sys
import os

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

from cs.cli import runner


def main():
    argv = sys.argv[1:]
    # Non-interactive runner subcommands may be given as `--server` / `server`,
    # `--payload` / `payload`, etc. Normalize a leading `--` so dispatch works.
    raw_argv = list(argv)
    _CMDS = ("server", "payload", "list", "task", "results",
             "disconnect", "delete",
             "reverse-shell", "rsh-list", "rsh-shell")
    norm = [a[2:] if a.startswith("--") and a[2:] in _CMDS else a for a in argv]

    subcommand = next((a for a in norm if a in _CMDS), None)
    if subcommand is None:
        # interactive console (TeamServer default data_dir = <repo>/data)
        from cs.cli.console import Console
        c = Console()
        try:
            c.run(None)
        except KeyboardInterrupt:
            print("\n[!] bye")
        return 0
    return runner.run(norm)


if __name__ == "__main__":
    sys.exit(main())
